# skhd — global app-launch / focus hotkeys (recovered from Raycast). macOS only.
# `open -a` focuses the app if running, launches it otherwise.
# Linux equivalent lives in KDE custom shortcuts (per the align plan).

cmd + shift - e : open -a "Microsoft Teams"
cmd + shift - o : open -a "Microsoft Outlook"

