{
    "python.defaultInterpreterPath": "",
    "explorer.confirmDragAndDrop": false,
    "window.zoomLevel": 1,
    "redhat.telemetry.enabled": false,
    "git.autofetch": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "black-formatter.importStrategy": "fromEnvironment",
    "githubPullRequests.pullBranch": "never",
    "vim.commandLineModeKeyBindings": [],
    "vim.easymotion": true,
    "vim.normalModeKeyBindings": [
        {
            "before": [ "<space>", "r" ], 
            "after": [],
            "commands": [
              { "command": "editor.action.rename", "args": [] }
            ]
        },
        {
            "before": [ "E" ],
            "after": [],
        }
    ],
    "jupyter.interactiveWindow.creationMode": "perFile",
    "files.associations": {
        "*.py": "python"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "github.copilot.advanced": {},
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "github.copilot.editor.enableAutoCompletions": true,
    "vim.vimrc.path": "$HOME/.vscodevimrc",
    "vim.vimrc.enable": true,
    "vim.leader": ",",
    "files.exclude": {
        "**/__pycache__": true,
        "**/.idea": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.venv": true
    },
    "diffEditor.renderSideBySide": true,
    "application.shellEnvironmentResolutionTimeout": 20,
    "workbench.iconTheme": "file-icons",
    "codeviz.analyticsEnabled": true,
    "codeviz.autoUpdate": false,
    "continue.telemetryEnabled": false,
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "files.autoSave": "afterDelay",
    "python.locator": "js",
    "git.openRepositoryInParentFolders": "never",
    "editor.accessibilitySupport": "off",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "cline.vsCodeLmModelSelector": {
        
    },
    "mcpManager.servers": [
        {
            "name": "FileSystem",
            "enabled": true,
            "command": "npx -y @modelcontextprotocol/server-filesystem /Users/username/Desktop /tmp/test",
            "type": "process"
        }
    ],
    "github.copilot.nextEditSuggestions.enabled": true,
    "workbench.colorTheme": "Dark+",
    "github.copilot.selectedCompletionModel": "",
    "python.analysis.typeCheckingMode": "standard",
    "docker.extension.enableComposeLanguageServer": false,
    "security.promptForLocalFileProtocolHandling": false,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilotcli:claude-sonnet-4.6",
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
    "docker.extension.dockerEngineAvailabilityPrompt": false,
    "chat.viewSessions.orientation": "stacked",
    "makefile.configureOnOpen": false
}
